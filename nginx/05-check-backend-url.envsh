#!/bin/sh
# Fail with a sentence instead of an nginx stack trace.
#
# The image's entrypoint (docker-entrypoint.sh) *sources* every executable *.envsh in
# /docker-entrypoint.d before it renders the templates, so the value changed below is still in the
# environment when 20-envsubst-on-templates.sh substitutes ${BACKEND_URL}. Two things to know before
# editing this file: a script without the executable bit is ignored in silence (the Dockerfile
# chmods it), and `set -e`/`set -u` here would apply to the entrypoint's own shell for the rest of
# the start-up, which is why this file sets neither.

if [ -z "${BACKEND_URL:-}" ]; then
  echo "ERROR: BACKEND_URL is not set." >&2
  echo "       It is where nginx forwards /api and /media. Examples:" >&2
  echo "         Railway (same project): http://backend.railway.internal:8080" >&2
  echo "         Railway (public URL):   https://your-api.up.railway.app" >&2
  echo "         Local container:        http://host.docker.internal:8080" >&2
  exit 1
fi

# proxy_pass with a trailing slash would produce requests to //api/..., which some servers answer
# and some do not. Strip it here rather than leaving it to whoever sets the variable.
BACKEND_URL="${BACKEND_URL%/}"
export BACKEND_URL

echo "nginx: /api and /media are proxied to ${BACKEND_URL}"

# The template names this resolver, so that upstream addresses are looked up per request rather than
# once at start-up. The base image can supply the list, but only when NGINX_ENTRYPOINT_LOCAL_RESOLVERS
# opts in (its docker-entrypoint.d/15-local-resolvers.envsh returns immediately otherwise), and this
# script runs before that one - so derive it here from the same file, and in the same way, including
# the brackets an IPv6 nameserver needs. An empty value would render "resolver ;", which nginx rejects
# with a message about the configuration rather than about the cause.
if [ -z "${NGINX_LOCAL_RESOLVERS:-}" ]; then
  NGINX_LOCAL_RESOLVERS=$(awk 'BEGIN{ORS=" "} $1=="nameserver" {if ($2 ~ ":") {print "["$2"]"} else {print $2}}' /etc/resolv.conf 2>/dev/null)
  NGINX_LOCAL_RESOLVERS="${NGINX_LOCAL_RESOLVERS% }"
  export NGINX_LOCAL_RESOLVERS
fi

if [ -z "${NGINX_LOCAL_RESOLVERS:-}" ]; then
  echo "ERROR: /etc/resolv.conf names no nameserver, so the resolver line in the template cannot be" >&2
  echo "       rendered. Without it nginx cannot resolve the backend this container proxies to." >&2
  exit 1
fi

echo "nginx: upstream addresses are resolved per request via ${NGINX_LOCAL_RESOLVERS}"
