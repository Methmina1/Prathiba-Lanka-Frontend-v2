# Rendered to /etc/nginx/conf.d/default.conf on every container start by
# docker-entrypoint.d/20-envsubst-on-templates.sh. ${PORT} and ${BACKEND_URL} come from the
# environment (see Dockerfile); nginx's own variables such as $uri are left alone.

server {
    listen       ${PORT};
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # Must be at least the backend's spring.servlet.multipart.max-request-size (70m), or an upload
    # is rejected here with a 413 that the admin console would report as an unknown error.
    client_max_body_size 70m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript application/json
               application/xml image/svg+xml;

    include /etc/nginx/security-headers.conf;

    # --- the API -------------------------------------------------------------------------------
    # Same origin from the browser's point of view, which is what removes CORS from the deployment.
    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        # Spring Security sets these on its own responses, so without this the browser receives two
        # of each - and for X-Frame-Options the values disagree (DENY against SAMEORIGIN here),
        # which is the kind of contradiction a browser resolves by ignoring both.
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        # Stream uploads straight through instead of spooling a 60 MB video to this container's disk.
        proxy_request_buffering off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # --- uploaded media ------------------------------------------------------------------------
    # Filenames are UUIDs generated per upload, so a cached copy can never be a stale one.
    location /media/ {
        proxy_pass ${BACKEND_URL}/media/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        # The same 30 days the backend sets in MediaWebConfig. It is restated here because nginx's
        # expires directive does not replace a Cache-Control header that came from the proxied
        # server, so the upstream one is dropped first - otherwise whatever the backend sends wins
        # and this line quietly does nothing.
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        # Same reason as in /api/: one copy of each security header, the one this file sets.
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        expires 30d;
        include /etc/nginx/security-headers.conf;
    }

    # --- health --------------------------------------------------------------------------------
    # What the platform polls (railway.json). It does not touch the backend, so a backend that is
    # down still leaves this service reporting on itself.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # --- static assets -------------------------------------------------------------------------
    # Vite puts a content hash in every filename, so these can be cached forever; a missing one is
    # a 404 rather than index.html, which would otherwise be served as JavaScript.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/security-headers.conf;
    }

    # The entry document must not be cached, or a browser keeps asking for the previous build's
    # asset names after a deploy.
    location = /index.html {
        add_header Cache-Control "no-store";
        include /etc/nginx/security-headers.conf;
    }

    # --- everything else -----------------------------------------------------------------------
    # Client-side routing: /journeys, /admin/... and the rest exist only in the browser, so an
    # unknown path is the app, not a missing file.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
